# Copy this file to .env (same folder) and fill in your values.
# .env is listed in .gitignore, so your real API key is never uploaded to GitHub.
# Never put a real key in this .env.example file.

# ---------------------------------------------------------------- Embeddings
# Multilingual embedding model from Hugging Face (used for retrieval).
# Alternatives:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   BAAI/bge-m3   (best quality, ~2.2 GB)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---------------------------------------------------------------- LLM (generation step of RAG)
# The LLM writes the final answer ONLY from the retrieved passages, with [n] citations.
# Easiest: start the app and use the sidebar panel "LLM (generation step)" - it writes these lines for you.
# Leave LLM_BASE_URL empty to use the offline extractive answerer instead.

# Groq (free API key from https://console.groq.com/keys) - used in this project:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_groq_api_key_here
# Other Groq models: openai/gpt-oss-20b (faster), llama-3.3-70b-versatile

# Google Gemini (free API key from https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=your_gemini_api_key_here

# Ollama (free, runs locally; install from https://ollama.com, then: ollama pull qwen2.5:3b):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama

# ---------------------------------------------------------------- Retrieval
TOP_K=5
