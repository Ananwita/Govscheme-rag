# Copy this file to .env and edit. Everything is optional.

# Embedding model (Hugging Face). Alternatives:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   BAAI/bge-m3   (best quality, ~2.2 GB)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---- Optional LLM for fluent answers (leave LLM_BASE_URL empty for offline extractive mode)
# Ollama (free, local):  install from https://ollama.com, then:  ollama pull qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama

# Groq (free API key from https://console.groq.com):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your_key_here

TOP_K=5
